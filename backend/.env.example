# Use localhost for a backend running on Windows. For Dockerized backend, use postgres as the host.
POSTGRES_DB=wealthsync
POSTGRES_USER=user_name
POSTGRES_PASSWORD=password

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional override, e.g. postgresql+psycopg://user:password@host:5432/wealthsync
# DATABASE_URL=
